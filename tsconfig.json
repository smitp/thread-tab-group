{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["firefox-webext-browser", "chrome"],
    "paths": { "@platform/client": ["./src/platform/firefox/client.ts"] },
    "isolatedModules": true
  },
  "include": ["src"]
}
